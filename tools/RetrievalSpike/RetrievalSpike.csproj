<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Evaluation harness for code-context retrieval: ranks a repository map's files for past issues and scores
    the ranking against the files their fixing pull requests changed. Not shipped; see tools/RetrievalSpike/README.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DiscordGithubBot\DiscordGithubBot.csproj" />
  </ItemGroup>

</Project>
