# Discord bot token (Discord Developer Portal -> Bot -> Token)
Discord__Token=your-discord-bot-token

# OpenAI. ServiceTier "flex" halves the price of the two chat calls in
# exchange for queued (sometimes rejected) responses -- see APP.md ->
# "Configuration". Set "default" to buy back standard latency.
OpenAI__ApiKey=sk-...
OpenAI__ChatModel=gpt-5.6-luna
OpenAI__EmbeddingModel=text-embedding-3-small
OpenAI__ServiceTier=flex

# SQLite location. Left commented out on purpose: appsettings.json already
# defaults to db/app.db locally, and the Docker image sets /data/app.db (the
# botdata volume). Setting it here would override the image with a path under
# the root-owned /app, which the container's non-root user cannot create.
# Uncomment only for a local run that needs a different path -- with compose,
# the only valid value is the container path:
# Database__Path=/data/app.db

# Apps: one block per configured app (index-based)
Apps__0__Name=MyApp
Apps__0__Repo=owner/repo
Apps__0__GitHubToken=github_pat_...
Apps__0__GuildIds__0=111111111111111111
Apps__0__ChannelIds__0=222222222222222222

# GitHub App instead of a PAT (exactly one of the two per app -- setting both
# is a startup error). Issues are then authored as <app-name>[bot]. See
# APP.md -> "GitHub credentials: PAT or GitHub App" for where the ids come
# from and which permissions the App needs (Issues R/W + Contents R/W).
# Comment out Apps__0__GitHubToken above before enabling this.
# Apps__0__GitHubApp__AppId=123456
# Apps__0__GitHubApp__InstallationId=987654321
#
# The private key. Do NOT try to inline the .pem here: a PEM is multi-line, and
# the "\n" escapes a shell leaves behind produce a key RSA cannot import --
# startup now rejects it outright instead of failing at the first report.
# Point at the file instead (this is the form for local runs and for a key you
# mount yourself):
# Apps__0__GitHubApp__PrivateKeyPath=/run/keys/app.pem
#
# The other form, Apps__0__GitHubApp__PrivateKey, takes the PEM text itself,
# and belongs in a key-per-file secret rather than in this file: with compose,
# a Docker secret named Apps__0__GitHubApp__PrivateKey whose *content* is the
# .pem binds directly -- no path, no newlines to get wrong. See
# docker-compose.yml, which ships that secret commented out.
